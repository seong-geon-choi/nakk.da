<resources>
    <!-- Compose가 창 전체를 그리므로 액션바/타이틀 제거. -->
    <style name="WearAppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Wear는 전체가 검정 배경이어야 함(WO-V13) + 시작 시 흰 플래시 방지. -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 시작 스플래시: 검정 배경 + 48dp 원형 아이콘(WO-V15). 이후 WearAppTheme로 전환. -->
    <style name="WearAppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/WearAppTheme</item>
    </style>
</resources>
