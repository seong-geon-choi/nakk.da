<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 카운트 시 진동(폰 '워치 설정'에서 켜면). -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Ongoing Activity(watch face "in progress" icon) notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/WearAppTheme">

        <uses-library android:name="com.google.android.wearable" android:required="true"/>
        <!-- 폰 앱과 짝을 이루는 컴패니언(단독 실행 아님). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"/>
        <!-- 화면 꺼짐(앰비언트)에도 앱을 활성으로 유지(워치페이스로 안 돌아감). -->
        <meta-data
            android:name="com.google.android.wearable.ambient.enabled"
            android:value="true"/>

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/WearAppTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
