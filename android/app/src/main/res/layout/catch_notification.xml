<?xml version="1.0" encoding="utf-8"?>
<!-- 조과 기록 알림 커스텀 뷰: 어종 +1 버튼을 본문에 직접 넣어 접힘/펼침·순서와
     무관하게 항상 보이게 한다. DecoratedCustomViewStyle이 상단 헤더(아이콘·앱명)를
     제공하므로 여기엔 카운트 한 줄 + 버튼 행만 둔다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- 시스템 알림과 동일한 텍스트 색(라이트/다크 자동)을 쓰도록 androidx 알림
         텍스트 스타일을 적용한다. 앱 테마의 textColorPrimary는 다크 알림에서 어두웠음. -->
    <TextView
        android:id="@+id/catch_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/catch_btn0"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/catch_btn1"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
